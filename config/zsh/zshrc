# Shared interactive Zsh settings.

# Personal or machine-specific values belong in this untracked file.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Add common user-installed command locations when they exist.
typeset -U path PATH
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
[[ -d /opt/homebrew/bin ]] && path=(/opt/homebrew/bin /opt/homebrew/sbin $path)

# Keep useful history across terminal sessions.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# Completion and familiar command-line editing.
autoload -Uz compinit && compinit
bindkey -e

if command -v uv >/dev/null 2>&1; then
    eval "$(uv generate-shell-completion zsh)"
fi

alias ..='cd ..'
alias ...='cd ../..'
alias g='git'
alias gs='git status --short --branch'

dotfiles_scripts_dir="${${(%):-%x}:A:h:h:h}/scripts"
alias pydebug='python3 "$dotfiles_scripts_dir/debug_env.py"'
alias pyimports='python3 "$dotfiles_scripts_dir/check_imports.py"'
alias pydeps='python3 "$dotfiles_scripts_dir/check_dependencies.py"'
alias pyports='python3 "$dotfiles_scripts_dir/check_ports.py"'
alias pyprocs='python3 "$dotfiles_scripts_dir/check_processes.py"'

source "${${(%):-%x}:A:h:h}/ai/ai.zsh"

if command -v eza >/dev/null 2>&1; then
    alias ll='eza -lah --git'
    alias la='eza -a'
else
    alias ll='ls -lah'
    alias la='ls -A'
fi

# Start the Starship prompt only while these dotfiles are installed.
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# rules for the Python toolchain
# see https://developers.openai.com/codex/rules/
# This is the Starlark syntax
#
# Python dependency management is unified on uv/uvx. This is enforced as a
# rule instead of an AGENTS.md instruction, since instructions can be
# skipped but a rule can't. The deciding question is "does it mutate the
# ambient Python environment": read-only pip usage has a uv equivalent
# (`uv pip list` / `uv pip show`), so pip is forbidden outright rather than
# just prompted.

prefix_rule(
    pattern = [["pip", "pip3"]],
    decision = "forbidden",
    justification = "pip mutates the ambient Python environment. Use `uv add`, `uv remove`, `uvx`, or `uv pip ...` instead.",
    match = [
        "pip install requests",
        "pip3 install -r requirements.txt",
        "pip uninstall requests",
        "pip list",
    ],
    not_match = [
        # `uv pip ...` is a uv subcommand, not pip itself.
        "uv pip list",
        "uv pip install requests",
    ],
)

prefix_rule(
    pattern = [["python", "python3"], "-m", "pip"],
    decision = "forbidden",
    justification = "`python -m pip` is pip by another name. Use `uv add`, `uv remove`, `uvx`, or `uv pip ...` instead.",
    match = [
        "python -m pip install requests",
        "python3 -m pip install -e .",
    ],
    not_match = [
        "python3 -m pytest",
    ],
)
